{
  "name": "planar-arm-planner",
  "version": "1.0.0",
  "description": "2-DOF planar manipulator kinematics, collision checking and joint-space path planning backend (API + CLI).",
  "type": "module",
  "bin": {
    "arm": "dist/cli/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit false --outDir dist",
    "start": "tsx src/cli/cli.ts serve",
    "cli": "tsx src/cli/cli.ts",
    "demo": "tsx src/demo/demo.ts",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
